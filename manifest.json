{
  "manifest_version": 3,
  "name": "PromptDeck — AI Prompt Queue",
  "version": "1.0.0",
  "description": "Draft and queue your next prompts while ChatGPT, Claude or Gemini is responding — deal them to the chatbox when YOU are ready.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PromptDeck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "insert-next-prompt": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Insert the next queued prompt into the chatbox"
    }
  }
}
